# 统一换行符：仓库里一律 LF，checkout 时也不做转换。
# 这是唯一能让"macOS 上开发、Linux 上跑 CI"两边行为一致的设置。
* text=auto eol=lf

# 二进制资源，别做任何文本转换
*.png  binary
*.jpg  binary
*.icns binary
*.zip  binary

# 脚本必须是 LF，否则在 Linux 上会 "bad interpreter: /bin/bash^M"
*.sh       text eol=lf
Makefile   text eol=lf
yi         text eol=lf
yi-app     text eol=lf

# GitHub 语言统计与 diff 折叠
docs/*          linguist-documentation
vendor/*        linguist-vendored
docs/assets/*   linguist-generated
*.svg           linguist-detectable=false
